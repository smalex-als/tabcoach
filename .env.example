# Copy to .env and fill in. The server reads this file at startup; .env is gitignored.

# Required for the ✨ tab-group suggestions in the extension.
OPENAI_API_KEY=sk-...

# Optional overrides.
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_MS=60000

# Smart grouping only moves a new tab when the model is at least this confident.
# SMART_GROUP_MIN_CONFIDENCE=0.6
